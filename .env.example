# AI展示面大师 — PySide6 桌面客户端配置（默认值见 app/config.py）
# 运行时数据（数据库/存储）默认落在 ./data（已 gitignore）

ENV=dev
DEBUG=true

# ============ 数据库 ============
# DATABASE_URL=sqlite:///./data/zhanshi.db
AUTO_CREATE_TABLES=true
SEED_DEMO_TEMPLATES=true

# ============ 存储 ============
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage
# S3 兼容对象存储（可选）：
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# S3_BUCKET=zhanshi-images
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx

# ============ AIGC 图生图（真实生图走 OpenAIClient；mock 为离线占位） ============
AIGC_PROVIDER=mock
AIGC_MOCK_DELAY=1.5
# 对接 OpenAI 兼容底座（官方留空 base_url）：
# AIGC_PROVIDER=openai
# AIGC_HTTP_URL=https://api.openai.com/v1      # 兼容底座 base_url（可选，留空用官方）
# AIGC_HTTP_TOKEN=sk-xxx                        # API Key
# AIGC_MODEL=gpt-image-1                        # 文生图/图生图模型
# AIGC_IMAGE_SIZE=1024x1024
# AIGC_TTI_RETRY=3                              # 单张生图重试次数

# ============ 业务规则（单机本地：试用 1 次 → 69 解锁赠送 69 次；无充值/支付） ============
WELCOME_CREDITS=69
