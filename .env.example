# ============ 应用 ============
ENV=dev
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ============ 数据库 / 缓存 ============
# 生产切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/zhanshi
DATABASE_URL=sqlite:///./zhanshi.db
# REDIS_URL=redis://localhost:6379/0   # 不填则 KV 退化进程内（仅单进程开发）
AUTO_CREATE_TABLES=true
SEED_DEMO_TEMPLATES=true

# ============ 存储 ============
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
VIEW_SIGN_TTL=3600
# S3 兼容对象存储（生产）：
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# S3_BUCKET=zhanshi-images
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx

# ============ 短信 ============
SMS_PROVIDER=mock
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms.provider.example.com/send
# SMS_HTTP_TOKEN=xxx

# ============ 支付 ============
PAYMENT_MODE=mock
# 微信支付 v3（生产）：
# PAYMENT_MODE=wechat
# WECHAT_APPID=wx...
# WECHAT_MCHID=16...
# WECHAT_API_V3_KEY=32位
# WECHAT_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# WECHAT_SERIAL_NO=商户证书序列号
# WECHAT_NOTIFY_URL=https://example.com/api/v1/payments/wechat/notify
# WECHAT_PLATFORM_CERT_PATH=./certs/wechatpay_platform.pem

# ============ AIGC ============
AIGC_PROVIDER=mock
AIGC_MOCK_DELAY=1.5
# AIGC_PROVIDER=http
# AIGC_HTTP_URL=https://aigc.provider.example.com/transform
# AIGC_HTTP_TOKEN=xxx

# ============ 认证 ============
JWT_SECRET=dev-only-please-change-this-secret-0123456789abcdef  # 生产务必更换
ADMIN_KEY=change-me-admin         # 生产务必更换

# ============ 业务规则 ============
WELCOME_CREDITS=69
UNLOCK_PRICE=6900
# RECHARGE_PACKAGES={"5000":50,"10000":100,"20000":200}

# ============ 异步任务 ============
CELERY_EAGER=true                # 生产置 false，并配 CELERY_BROKER_URL=redis://...
CELERY_BROKER_URL=memory://